{
  "name": "oydin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Oydin — fikrlarni yozish, bog'lash va ko'rish uchun shaxsiy fikr makoni.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alisher-ds/oydin-uz.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler pages dev . --port 8788",
    "serve": "npx --yes http-server . -p 8000 -c-1",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:format",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "eslint": "^9.37.0",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.1"
  }
}
