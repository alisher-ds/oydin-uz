{
  "name": "oydin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Oydin \u2014 fikrlarni yozish, bog'lash va ko'rish uchun shaxsiy fikr makoni.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alisher-ds/oydin-uz.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler pages dev . --port 8788",
    "serve": "npx --yes http-server . -p 8000 -c-1",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:format",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --disable-warning=ExperimentalWarning --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "eslint": "^9.37.0",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.1"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "arrowParens": "avoid",
    "trailingComma": "none"
  },
  "stylelint": {
    "extends": "stylelint-config-standard",
    "rules": {
      "no-descending-specificity": null,
      "custom-property-empty-line-before": null,
      "declaration-empty-line-before": null,
      "comment-empty-line-before": null,
      "rule-empty-line-before": null,
      "alpha-value-notation": null,
      "color-function-notation": null,
      "value-keyword-case": null,
      "selector-class-pattern": null,
      "font-family-name-quotes": null,
      "media-feature-range-notation": null,
      "selector-id-pattern": null,
      "keyframes-name-pattern": null,
      "custom-property-pattern": null
    }
  }
}
